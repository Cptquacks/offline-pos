{
  "name": "offline-pos",
  "private": false,
  "version": "2.0.0",
  "main": "./src/electron/main.js",
  "type": "module",
  "description": "POS",
  "author": {
    "name": "Shard Development Team",
    "email": "zgenshinzgenshin@gmail.com"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:win": "npm run build && npx --verbose electron-builder --win",
    "build:linux": "npm run build && npx --verbose electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "build": {
    "appId": "com.shard.kepler",
    "productName": "Kepler",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "copyright": "Copyright © 2026 Shard Development Team",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Kepler-Portable-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.svg",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.4",
    "wait-on": "^9.0.3"
  }
}
